# V1 — webhook router for AnotherAgent
GITHUB_PAT=ghp_replace_me
GITHUB_DEFAULT_REPO=owner/another_agent_frontend
CLAUDE_BIN_PATH=/Users/you/.nvm/versions/node/v22.18.0/bin/claude
WORKSPACE_DIR=/Users/you/Desktop/AnohterAgent Projects

# Where Claude Code runs (cwd) when instruct_planning/implementation fires.
# Must match the local clone of GITHUB_DEFAULT_REPO for v1.
CODING_REPO_PATH=/Users/you/Desktop/AnohterAgent Projects/another_agent_frontend

# Branch agent PRs are branched from and targeted at. Default: dev
# (main is reserved for releases in this workspace — never let the agent
# touch main directly).
BASE_BRANCH=dev

# Legacy — keep until /implementTicket is removed
ANOTHER_LOGIC_API_KEY=sk_live_replace_me
ANOTHER_LOGIC_BASE_URL=http://localhost:3000

# Shared secret required on the X-Coder-Key header for /chat/stream,
# /tools/*, and /jobs/*. /health stays unauthed for uptime checks.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into your AnotherAgent agent's llmConfig.coderApiKey.
ANOTHER_CODER_API_KEY=replace_me_with_a_random_token
