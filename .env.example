# another_bridge — environment variables
#
# Copy this file to `.env` and fill in the values that apply to your
# host. uvicorn loads `.env` via python-dotenv at startup. Empty /
# unset entries fall back to the documented defaults.

# ──────────────────────────────────────────────────────────────────────
# GitHub
# ──────────────────────────────────────────────────────────────────────

# Personal access token used by services/github_service.py to read
# issues + open PRs. The PAT must have `repo` scope.
GITHUB_PAT=ghp_replace_me

# Default GitHub slug used when the platform doesn't pass one
# explicitly. Format: owner/repo.
GITHUB_DEFAULT_REPO=owner/another_agent_frontend

# ──────────────────────────────────────────────────────────────────────
# Claude Code
# ──────────────────────────────────────────────────────────────────────

# Model for the platform chat bridge (/chat/stream and the webhook
# tools). Unset → claude-haiku-4-5 (cheap default in code); set to a
# stronger model for real work. Mobile resume has its own knob
# (ANOTHER_CODER_RESUME_MODEL, default claude-opus-4-8).
CLAUDE_MODEL=claude-opus-4-8

# Absolute path to the `claude` CLI binary. NVM / nodenv / asdf users:
# uvicorn inherits the parent process's PATH, which on daemonized
# launches usually does NOT include ~/.nvm/versions/node/<v>/bin.
# Setting this nails the binary path so the spawn doesn't [Errno 2]
# after a host reboot. If unset, falls back to bare "claude" and lets
# PATH resolve.
CLAUDE_BIN_PATH=/Users/you/.nvm/versions/node/v22.18.0/bin/claude

# ──────────────────────────────────────────────────────────────────────
# Repo locations
# ──────────────────────────────────────────────────────────────────────

# Parent directory containing your local clones. Used by
# /tools/list_repos for enumeration AND by validate_repo_path() to
# bound every spawn cwd — Claude Code (which runs with
# --dangerously-skip-permissions) cannot run outside this directory
# regardless of what repo_path the caller sends.
#
# STRONGLY recommended for any deployment exposed via ngrok. Leaving
# it empty preserves the legacy "isdir-only" behavior, which is
# weaker — Claude Code can spawn in any directory the uvicorn user
# can read, including $HOME, ~/.ssh, /etc.
#
# Docker users: docker-compose.yml reads this same WORKSPACE_ROOT
# value and bind-mounts it 1:1 (same path inside and outside the
# container). Single source of truth — set it here, both `uvicorn`
# and `docker compose up` honor it identically with no translation.
WORKSPACE_ROOT=/Users/you/Desktop/AnohterAgent Projects

# Default repo path when the platform doesn't pass one. Must be a
# real git repo (has a .git/ subdir) and (when WORKSPACE_ROOT is
# set) must be a subdirectory of it.
CODING_REPO_PATH=/Users/you/Desktop/AnohterAgent Projects/another_agent_frontend

# Branch agent PRs are branched from and targeted at. Defaults to
# the remote's default branch when unset; override with `dev` if
# main is reserved for releases (the recommended layout — never let
# the agent push to main).
BASE_BRANCH=dev

# ──────────────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────────────

# Shared secret required on the X-Coder-Key header for /chat/stream,
# /tools/*, /jobs/*, and /auth/verify. /health stays unauthed for
# uptime checks. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into the AnotherAgent platform's app-level
# `another_coder` integration (Settings → Integrations → another_coder).
ANOTHER_CODER_API_KEY=replace_me_with_a_random_token

# ──────────────────────────────────────────────────────────────────────
# Persistence (Phase 2 refactor)
# ──────────────────────────────────────────────────────────────────────

# Where the SQLite-backed session store lives. The file persists
# the (conversation_id → Claude Code session_id) map across
# uvicorn restarts so a mid-day deploy doesn't drop every active
# conversation back to a fresh session. Default:
# ~/.another_coder/sessions.db. Tests use ":memory:" via conftest.py.
ANOTHER_CODER_SESSION_DB_PATH=

# TTL reaper tunables. The daemon thread runs every interval and
# prunes stale state from JobManager._jobs and the session store.
# Defaults sized for a small deployment; raise the job TTL if you
# need a longer post-mortem window for failed jobs (trace forensics).
ANOTHER_CODER_JOB_TTL_SECONDS=3600           # 1h: drop done/failed jobs older than this
ANOTHER_CODER_SESSION_TTL_SECONDS=604800     # 7d: drop sessions inactive longer than this
ANOTHER_CODER_REAPER_INTERVAL_SECONDS=600    # 10min: how often the reaper wakes

# ──────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────
#
# Per-route caps applied via slowapi (in-process, no Redis needed).
# Keyed on the X-Coder-Key header, with remote-IP fallback. Values are
# slowapi specs like "30/minute" / "5/second"; empty string disables
# the limit on that surface. Conservative defaults below — the
# leaked-key blast radius is bounded by these even before the operator
# rotates the secret. /jobs/* is generous because the platform polls
# status at ~5s cadence per active job.
ANOTHER_CODER_RATE_LIMIT_CHAT_STREAM=30/minute
ANOTHER_CODER_RATE_LIMIT_INSTRUCT=10/minute
ANOTHER_CODER_RATE_LIMIT_JOBS=600/minute
ANOTHER_CODER_RATE_LIMIT_AUTH_VERIFY=60/minute
